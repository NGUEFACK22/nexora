{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --prod=false",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist/**,node_modules/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
