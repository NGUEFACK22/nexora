{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --prod=false",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/**,node_modules/.prisma/**,node_modules/@prisma/**,node_modules/bcrypt/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.ts" }]
}
