# ============================================================
# NEXORA — Variables d'environnement pour VERCEL (frontend uniquement)
#
# IMPORT : Vercel → Settings → Environment Variables → Import env file
#
# ⚠️  Ce fichier ne contient AUCUN secret : les variables du backend
#     (DATABASE_URL, JWT_SECRET, ENCRYPTION_KEY, AGENTMAIL_API_KEY,
#     GOOGLE_GENERATIVE_AI_API_KEY, TELEGRAM_TOKEN, clés Cloudflare…)
#     se configurent sur RAILWAY (le serveur backend), pas sur Vercel.
#
# ⚠️  2 valeurs à remplacer par vos URL réelles (marquées À REMPLACER).
# ============================================================

# --- Essentielles ---

# URL publique de votre backend déployé sur Railway (À REMPLACER après
# avoir créé le backend sur Railway — Generate Domain). Sans elle, le
# frontend s'affiche mais aucune donnée ne charge.
NEXT_PUBLIC_BACKEND_URL=https://VOTRE-BACKEND.up.railway.app

# URL publique du frontend Vercel (À REMPLACER après le premier déploiement :
# Settings → Domains, ex. https://nexora.vercel.app ou votre domaine custom).
# Elle est utilisée pour les cookies de session et les liens d'emails.
FRONTEND_URL=https://VOTRE-APP.vercel.app
MAIN_URL=https://VOTRE-APP.vercel.app

# Mode de l'application : "true" = plateforme publique Nexora (branding,
# inscriptions ouvertes). Laisser "true".
IS_GENERAL=true

# Stockage des médias : Cloudflare R2 (déjà configuré et testé).
STORAGE_PROVIDER=cloudflare

# --- Cloudflare R2 (valeurs NON secrètes utilisées par le frontend) ---

# URL publique du bucket (lecture des médias par les réseaux sociaux).
CLOUDFLARE_BUCKET_URL=https://pub-07a6cae1b27c4cbfa456b3365f0ac467.r2.dev

# --- Canal Telegram ---

# Nom public du bot (affiché lors de la connexion du canal).
TELEGRAM_BOT_NAME=ui_j7blyuucswxr2d7yxw_bot

# --- Optionnelles : chaque fonction reste désactivée si la variable est absente ---
# Analytics / tags :
#NEXT_PUBLIC_GTM_ID=
#NEXT_PUBLIC_FACEBOOK_PIXEL=
#NEXT_PUBLIC_DISCORD_SUPPORT=
#NEXT_PUBLIC_TRACKING_TRIAL=
#NEXT_PUBLIC_VERSION=
# Éditeur visuel Polotno :
#NEXT_PUBLIC_POLOTNO=
# Monitoring Sentry :
#NEXT_PUBLIC_SENTRY_DSN=
# Extension navigateur (si vous la publiez) :
#EXTENSION_ID=
# Serveur MCP dédié (si séparé du backend) :
#MCP_URL=
# Captcha (page de commentaires publics) :
#RECAPTCHA_SITE_KEY=

# ⚠️  Ne définissez JAMAIS NOT_SECURED ici : réservé au développement local.
