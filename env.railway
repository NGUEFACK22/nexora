# ============================================================
# NEXORA — Variables d'environnement pour RAILWAY (backend + orchestrator)
#
# Railway → votre service → Variables → ajoutez chaque ligne
# (ou "Raw Editor" et collez le bloc ci-dessous, valeurs remplacées).
#
# ⚠️  Remplacez les valeurs entre <...> :
#     - les secrets : copiez-les depuis votre .env local (ils y sont déjà)
#     - les URLs : générées par Railway et Vercel après création des services
# ============================================================

# --- Socle (obligatoires — vérifiées au démarrage) ---
DATABASE_URL=<URL Neon complète — copiez-la de votre .env local>
REDIS_URL=<redis://… fourni par Railway ou Upstash>
TEMPORAL_ADDRESS=<host:port du serveur Temporal>
JWT_SECRET=<copiez-le de votre .env local>
ENCRYPTION_PROVIDER=local
ENCRYPTION_KEY=<copiez-le de votre .env local>
MAIN_URL=<https://VOTRE-APP.vercel.app>
FRONTEND_URL=<https://VOTRE-APP.vercel.app>
NEXT_PUBLIC_BACKEND_URL=<https://VOTRE-BACKEND.up.railway.app>
BACKEND_INTERNAL_URL=<https://VOTRE-BACKEND.up.railway.app>
IS_GENERAL=true

# --- Stockage Cloudflare R2 (déjà validé) ---
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=be5a3348e9255e4034bbbe8d326c6607
CLOUDFLARE_ACCESS_KEY=<copiez-le de votre .env local>
CLOUDFLARE_SECRET_ACCESS_KEY=<copiez-le de votre .env local>
CLOUDFLARE_BUCKETNAME=moi
CLOUDFLARE_BUCKET_URL=https://pub-07a6cae1b27c4cbfa456b3365f0ac467.r2.dev
CLOUDFLARE_REGION=auto

# --- Emails (AgentMail — déjà testé) ---
EMAIL_PROVIDER=agentmail
AGENTMAIL_API_KEY=<copiez-le de votre .env local>
AGENTMAIL_INBOX_ID=wickednumber735@agentmail.to
EMAIL_FROM_ADDRESS=wickednumber735@agentmail.to
EMAIL_FROM_NAME=Nexora

# --- IA (Google Gemini — déjà testé) ---
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=<copiez-le de votre .env local>
# Supprimez la ligne AI_MODEL quand la surcharge Google sera passée :
AI_MODEL=gemini-flash-lite-latest

# --- Canal Telegram (token validé) ---
TELEGRAM_TOKEN=<copiez-le de votre .env local>
TELEGRAM_BOT_NAME=ui_j7blyuucswxr2d7yxw_bot

# ⚠️  Ne définissez jamais NOT_SECURED ni NOT_SECURED=true ici.
